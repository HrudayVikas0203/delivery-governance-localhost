APP_NAME="Delivery Governance Backend"
ENVIRONMENT=local
API_PREFIX=/api/v1
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Render must provide DATABASE_URL with the real password stored securely in the environment.
# Never commit credentials or a real password here.
# Do not append ssl-mode=REQUIRED to the URL. Set SSL through PyMySQL connection args instead.
DATABASE_URL=mysql+pymysql://avnadmin:REPLACE_WITH_PASSWORD@mysql-20d84f9-hrudayvikas2004-cd10.a.aivencloud.com:13207/defaultdb?charset=utf8mb4
DATABASE_BACKEND=sqlite

# MySQL (optional if DATABASE_BACKEND=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=delivery_governance
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://del-gov-delta-k2zs.vercel.app,https://del-gov-delta.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Chroma
CHROMA_PERSIST_DIRECTORY=backend/storage/chroma
CHROMA_COLLECTION=delivery_governance_knowledge

# Optional LLM providers. Only configured providers are selectable.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-3-5-sonnet-latest

# Reports
REPORT_OUTPUT_DIR=backend/storage/reports
REPORT_TEMPLATES_DIR=backend/storage/report_templates
PPT_TEMPLATE_MAX_BYTES=12582912

# Demo data
SEED_DEMO_DATA=true

# SMTP email scheduling
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
